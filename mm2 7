------------------------------------------------ Rows + painting
local rows = {}
local info

local function paint()
	local t = current
	local h = (os.clock() * 0.25) % 1
	local acc = t.rainbow and Color3.fromHSV(h, 0.65, 1) or t.accent
	local bg = t.rainbow and Color3.fromHSV(h, 0.5, 0.16) or t.bg
	local panel = t.rainbow and Color3.fromHSV(h, 0.45, 0.28) or t.panel
	main.BackgroundColor3 = bg
	stroke.Color = acc
	title.TextColor3 = acc
	small.BackgroundColor3 = acc
	if info then info.TextColor3 = acc end
	for _, r in ipairs(rows) do
		r.btn.BackgroundColor3 = r.on() and acc or panel
	end
end

local function addToggle(name, cb)
	local on = false
	local b = new("TextButton", {
		Size = UDim2.new(1, -6, 0, 34), BackgroundTransparency = 0.15, Text = name .. "  OFF",
		Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.7, AutoButtonColor = false, ZIndex = 3,
	}, list)
	corner(b, 8)
	table.insert(rows, {btn = b, on = function() return on end})
	bind(b.Activated, function()
		on = not on
		b.Text = name .. (on and "  ON" or "  OFF")
		paint()
		cb(on)
	end)
end

