	while alive do
		pcall(function()
			if state.esp then updateESP() end
			updateInfo()
		end)
		task.wait(0.5)
	end
end)

paint()
main.Size = UDim2.fromOffset(250, 0)
TS:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = FULL}):Play()

env.MM2Hub_Cleanup = function()
	alive = false
	state.esp, state.fly = false, false
	pcall(clearESP)
	pcall(stopFly)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	gui:Destroy()
end
