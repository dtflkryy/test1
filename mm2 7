------------------------------------------------ Features
local state = {esp = false, speed = false, jump = false, noclip = false, fly = false}
local SPEED, FLY_SPEED = 45, 60

local function roleOf(p)
	local c = p.Character
	local bp = p:FindFirstChild("Backpack")
	local function has(n) return (c and c:FindFirstChild(n)) or (bp and bp:FindFirstChild(n)) end
	if has("Knife") then return "M" end
	if has("Gun") then return "S" end
	return "I"
end
local roleColor = {M = Color3.fromRGB(255, 50, 50), S = Color3.fromRGB(60, 140, 255), I = Color3.fromRGB(80, 255, 120)}

local function clearESP()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChild("MM2ESP")
		if h then h:Destroy() end
	end
end

local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local h = p.Character:FindFirstChild("MM2ESP")
			if not h then
				h = new("Highlight", {Name = "MM2ESP", FillTransparency = 0.5, OutlineTransparency = 0,
					DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, p.Character)
			end
			local col = roleColor[roleOf(p)]
			h.FillColor = col
			h.OutlineColor = col
		end
	end
end

local function updateInfo()
	local m, s = "?", "?"
	for _, p in ipairs(Players:GetPlayers()) do
		local r = roleOf(p)
		if r == "M" then m = p.Name elseif r == "S" then s = p.Name end
	end
	info.Text = "🔪 Murderer: " .. m .. "\n🔫 Sheriff: " .. s
end

local function char() return lp.Character end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end

addToggle("ESP vai trò", function(v)
	state.esp = v
	if not v then clearESP() else updateESP() end
end)
addToggle("Speed " .. SPEED, function(v)
	state.speed = v
	if not v then local h = hum() if h then h.WalkSpeed = 16 end end
end)
addToggle("Infinite Jump", function(v) state.jump = v end)
addToggle("Noclip", function(v) state.noclip = v end)

local bv
local function stopFly()
	if bv then bv:Destroy() bv = nil end
end
addToggle("Fly", function(v)
	state.fly = v
	if not v then stopFly() end
end)

addToggle("Anti-AFK", function(v)
	env.MM2Hub_AFK = v
end)
bind(lp.Idled, function()
	if env.MM2Hub_AFK then
		pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end
end)

bind(UIS.JumpRequest, function()
	if state.jump then
		local h = hum()
		if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

bind(RS.Stepped, function()
	if state.noclip and char() then
		for _, part in ipairs(char():GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end
end)

bind(RS.Heartbeat, function()
	if current.rainbow then paint() end
	local h = hum()
	if state.speed and h then h.WalkSpeed = SPEED end
	if state.fly then
		local root = hrp()
		if root then
			if not bv or bv.Parent ~= root then
				stopFly()
				bv = new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, root)
			end
			local cam = workspace.CurrentCamera
			if h and h.MoveDirection.Magnitude > 0 then
				bv.Velocity = cam.CFrame.LookVector * FLY_SPEED
			else
				bv.Velocity = Vector3.zero
			end
		end
	end
end)

