local locked = false
do
	local dragging, dragStart, startPos
	track(top.InputBegan:Connect(function(i)
		if locked then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, i.Position, main.Position
		end
	end))
	track(UIS.InputChanged:Connect(function(i)
		if dragging and not locked and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

track(lockBtn.Activated:Connect(function()
	locked = not locked
	lockBtn.Text = locked and "🔒" or "🔓"
	lockBtn.BackgroundColor3 = locked and ACCENT or BG
end))

local function toggleGui() main.Visible = not main.Visible end
track(closeBtn.Activated:Connect(function() main.Visible = false end))

-- Nút 🎵: kéo thả được (trừ khi đang khoá), chạm nhẹ để ẩn/hiện GUI
do
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	track(openBtn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			moved = false
			dragging = not locked
			dragStart, startPos = i.Position, openBtn.Position
		end
	end))
	track(UIS.InputChanged:Connect(function(i)
		if dragging and not locked and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			if d.Magnitude > 6 then moved = true end
			if moved then
				openBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	track(openBtn.Activated:Connect(function()
		if moved then return end -- vừa kéo thì không tính là bấm
		toggleGui()
	end))
end

----------------------------------------------------------------
-- TOOL + BOOMBOX TREO LƯNG
----------------------------------------------------------------
-- Tăng số này để boombox sát vào lưng hơn, giảm để ra xa hơn
local BACK_INSET = 0.3

local currentTool, backProp, saved = nil, nil, {}

local function setBackVisible(v)
	if not backProp then return end
	local list = backProp:GetDescendants()
	table.insert(list, backProp)
	for _, d in ipairs(list) do
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			if saved[d] == nil then saved[d] = d.Transparency end
			d.Transparency = v and saved[d] or 1
		end
	end
end

local function buildBackProp(char)
	if backProp then pcall(function() backProp:Destroy() end) end
	backProp, saved = nil, {}
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
	local handle = template:FindFirstChild("Handle")
	if not (torso and handle) then return end

	local p = handle:Clone()
	for _, d in ipairs(p:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("TouchTransmitter") or d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
	p.Name = "BoomboxBack"
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Parent = char

	local w = Instance.new("Weld")
	w.Part0 = torso
	w.Part1 = p
	w.C0 = CFrame.new(0, 0, 0.5 + p.Size.Z / 2 - BACK_INSET) * CFrame.Angles(0, math.pi, 0)
	w.Parent = p

	backProp = p
	setBackVisible(not (currentTool and currentTool.Parent == char))
end

local function giveTool()
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack then return end
	if currentTool then pcall(function() currentTool:Destroy() end) end
	local t = template:Clone()
	t.Parent = backpack
	currentTool = t
	t.Equipped:Connect(function() setBackVisible(false) end)
	t.Unequipped:Connect(function() setBackVisible(true) end)
	t.Activated:Connect(toggleGui)
end

local busy = false
local function setup(char)
	if busy then return end
	busy = true
	pcall(function()
		char:WaitForChild("Humanoid")
		char:WaitForChild("HumanoidRootPart")
		task.wait(0.3)
		giveTool()
		buildBackProp(char)
	end)
	busy = false
end

track(player.CharacterAdded:Connect(setup))
if player.Character then task.spawn(setup, player.Character) end

-- Vòng kiểm tra: nếu game xoá item/prop thì tự thêm lại
task.spawn(function()
	while alive do
		task.wait(1)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and not busy then
			local bp = player:FindFirstChild("Backpack")
			if bp and (not currentTool or (currentTool.Parent ~= bp and currentTool.Parent ~= char)) then
				busy = true
				pcall(giveTool)
				busy = false
			end
			if not backProp or not backProp.Parent then
				busy = true
				pcall(buildBackProp, char)
				busy = false
			end
		end
	end
end)

----------------------------------------------------------------
-- DỌN DẸP KHI CHẠY LẠI SCRIPT
----------------------------------------------------------------
env.__BoomboxCleanup = function()
	alive = false
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	pcall(function() gui:Destroy() end)
	pcall(function() sound:Destroy() end)
	pcall(function() if currentTool then currentTool:Destroy() end end)
	pcall(function() if backProp then backProp:Destroy() end end)
end
