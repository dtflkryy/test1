-- 10 equalizer xếp chồng, mỗi cái tối đa +10 dB => tổng tối đa +100 dB
local eqs = {}
for i = 1, 10 do
	local e = Instance.new("EqualizerSoundEffect")
	e.LowGain, e.MidGain, e.HighGain = 0, 0, 0
	e.Parent = sound
	eqs[i] = e
end

