local template
do
	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://212641536") end)
	if ok and objs then
		for _, o in ipairs(objs) do
			if o:IsA("Tool") then template = o break end
			local t = o:FindFirstChildWhichIsA("Tool", true)
			if t then template = t break end
		end
	end
	if not template then
		template = Instance.new("Tool")
		template.Name = "Boombox"
		local h = Instance.new("Part")
		h.Name = "Handle"
		h.Size = Vector3.new(1.5, 1, 0.6)
		h.Parent = template
	end
	for _, d in ipairs(template:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then d:Destroy() end
	end
	template.CanBeDropped = false
	template.RequiresHandle = true
end

