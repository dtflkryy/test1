-- Bass (nhập số dB)
local BASS_MIN, BASS_MAX = -20, 100
local currentBass = 0
local function setBass(v)
	v = math.clamp(v, BASS_MIN, BASS_MAX)
	currentBass = v
	local remain = v
	for i, e in ipairs(eqs) do
		if v < 0 then
			e.LowGain = (i == 1) and v or 0
		else
			local g = math.min(remain, 10)
			e.LowGain = g
			remain = remain - g
		end
	end
	bassBox.Text = fmt(v)
end
local function applyBass()
	local n = tonumber(bassBox.Text)
	setBass(n or currentBass)
end
track(applyBassBtn.Activated:Connect(applyBass))
track(bassBox.FocusLost:Connect(applyBass))

