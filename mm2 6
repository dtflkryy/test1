local function addToggle(page, text, key, cb)
	local r = row(page)
	label(r, text, UDim2.fromOffset(12, 0), UDim2.new(1, -70, 1, 0))
	local sw = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(40, 20), BackgroundColor3 = OFF}, r)
	corner(sw, UDim.new(1, 0))
	local knob = new("Frame", {Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE}, sw)
	corner(knob, UDim.new(1, 0))
	local function paint(anim)
		local on = S[key]
		local col = on and accent or OFF
		local pos = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
		if anim then
			tw(sw, 0.2, {BackgroundColor3 = col})
			tw(knob, 0.25, {Position = pos}, Enum.EasingStyle.Back)
		else
			sw.BackgroundColor3 = col
			knob.Position = pos
		end
	end
	refreshers[#refreshers + 1] = function() if S[key] then sw.BackgroundColor3 = accent end end
	bind(sw.MouseButton1Click, function()
		S[key] = not S[key]
		paint(true)
		if cb then cb(S[key]) end
	end)
	paint(false)
end
local function addSlider(page, text, key, min, max, cb)
	local r = row(page, 48)
	label(r, text, UDim2.fromOffset(12, 4), UDim2.new(1, -70, 0, 18))
	local val = label(r, tostring(S[key]), UDim2.new(1, -62, 0, 4), UDim2.fromOffset(50, 18), Enum.TextXAlignment.Right)
	local bar = new("Frame", {Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = OFF, BorderSizePixel = 0}, r)
	corner(bar, UDim.new(1, 0))
	local fill = new("Frame", {Size = UDim2.fromScale((S[key] - min) / (max - min), 1), BorderSizePixel = 0}, bar)
	corner(fill, UDim.new(1, 0))
	regAccent(fill, "BackgroundColor3")
	local hit = new("TextButton", {Position = UDim2.fromOffset(6, 22), Size = UDim2.new(1, -12, 0, 24), BackgroundTransparency = 1, Text = ""}, r)
	local dragging = false
	local function upd(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = math.floor(min + (max - min) * a + 0.5)
		S[key] = v
		fill.Size = UDim2.fromScale(a, 1)
		val.Text = tostring(v)
		if cb then cb(v) end
	end
	local function isPtr(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
	bind(hit.InputBegan, function(i)
		if isPtr(i) then dragging = true; page.ScrollingEnabled = false; upd(i.Position.X) end
	end)
	bind(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
	end)
	bind(UIS.InputEnded, function(i)
		if dragging and isPtr(i) then dragging = false; page.ScrollingEnabled = true end
	end)
end
local function addButton(page, text, cb)
	local r = row(page, 34)
	local b = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = WHITE}, r)
	bind(b.MouseButton1Click, function()
