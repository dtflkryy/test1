local espFolder = new("Folder", {Name = "ESP"}, gui)
local espData = {}
local roleColors = {Murderer = Color3.fromRGB(255, 60, 60), Sheriff = Color3.fromRGB(70, 150, 255), Innocent = Color3.fromRGB(90, 230, 120)}
local hud = new("TextLabel", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(300, 22),
	BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WHITE,
	RichText = true, Visible = false, Text = ""}, gui)
corner(hud, UDim.new(0, 8))

local function clearESP(p)
	local d = espData[p]
	if d then
		if d.hl then d.hl:Destroy() end
		if d.bb then d.bb:Destroy() end
		espData[p] = nil
	end
end
local function updateESP()
	if not (S.esp or S.tags or S.hud) then
		for p in pairs(espData) do clearESP(p) end
		hud.Visible = false
		return
	end
	local mur, she
	local myHRP = getHRP()
	for _, p in ipairs(Players:GetPlayers()) do
		local role = getRole(p)
		if role == "Murderer" then mur = p.DisplayName elseif role == "Sheriff" then she = p.DisplayName end
		if p ~= LP then
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if (S.esp or S.tags) and hrp then
				local d = espData[p] or {}
				espData[p] = d
				local col = roleColors[role]
				if S.esp then
					if not d.hl or d.hl.Adornee ~= char then
						if d.hl then d.hl:Destroy() end
						d.hl = new("Highlight", {Adornee = char, FillTransparency = 0.6, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, espFolder)
					end
					d.hl.FillColor = col
					d.hl.OutlineColor = col
				elseif d.hl then d.hl:Destroy(); d.hl = nil end
				if S.tags then
					local head = char:FindFirstChild("Head") or hrp
					if not d.bb or d.bb.Adornee ~= head then
						if d.bb then d.bb:Destroy() end
						d.bb = new("BillboardGui", {Adornee = head, Size = UDim2.fromOffset(130, 34), StudsOffset = Vector3.new(0, 2.2, 0), AlwaysOnTop = true}, espFolder)
						d.txt = new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextStrokeTransparency = 0.4}, d.bb)
					end
					local dist = myHRP and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0
					d.txt.Text = p.DisplayName .. " [" .. role .. "]\n" .. dist .. "m"
					d.txt.TextColor3 = col
				elseif d.bb then d.bb:Destroy(); d.bb = nil end
			else
				clearESP(p)
			end
		end
	end
	hud.Visible = S.hud
	if S.hud then
		hud.Text = string.format("<font color='#ff4d4d'>Murderer: %s</font>   <font color='#4da6ff'>Sheriff: %s</font>", mur or "?", she or "?")
	end
end
bind(Players.PlayerRemoving, clearESP)

