local function selectTab(i)
	curTab = i
	for k, t in ipairs(tabs) do
		local on = (k == i)
		t.btn.BackgroundTransparency = on and 0.15 or 0.6
		t.btn.BackgroundColor3 = on and accent or Color3.new(0, 0, 0)
		if on and not t.page.Visible then
			t.page.Position = UDim2.fromOffset(0, 12)
			t.page.Visible = true
			tw(t.page, 0.25, {Position = UDim2.fromOffset(0, 0)})
		elseif not on then
			t.page.Visible = false
		end
	end
end
