		task.delay(0.1, function() tw(r, 0.3, {BackgroundTransparency = 0.55}) end)
		if cb then task.spawn(cb) end
	end)
end

--// Game logic
local function getChar() return LP.Character end
local function getHRP() local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = LP.Character; return c and c:FindFirstChildOfClass("Humanoid") end

local function getRole(plr)
	local char, bp = plr.Character, plr:FindFirstChild("Backpack")
	local function has(n) return (char and char:FindFirstChild(n)) or (bp and bp:FindFirstChild(n)) end
	if has("Knife") then return "Murderer" end
	if has("Gun") then return "Sheriff" end
	return "Innocent"
end

local function anyPart(container)
	if not container then return nil end
	local list = {}
	for _, d in ipairs(container:GetDescendants()) do if d:IsA("BasePart") then list[#list + 1] = d end end
	return list[#list > 0 and math.random(#list) or 1]
end
local function findMap()
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and m:FindFirstChild("CoinContainer") then return m end
	end
end
local function tpTo(part)
	local hrp = getHRP()
	if hrp and part then hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0) end
end
local function touch(a, b)
	if firetouchinterest then pcall(function() firetouchinterest(a, b, 0); firetouchinterest(a, b, 1) end) end
end

local gunBusy = false
local function grabGun(silent)
	local gun, hrp = workspace:FindFirstChild("GunDrop"), getHRP()
	if gunBusy then return end
	if not gun or not hrp then if not silent then notify("No gun dropped") end return end
	gunBusy = true
	local back = hrp.CFrame
	hrp.CFrame = gun.CFrame
	touch(hrp, gun)
	task.wait(0.25)
	hrp.CFrame = back
	gunBusy = false
	notify("Gun grabbed")
end

