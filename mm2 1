local TabBar = New("Frame", {Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 46), BackgroundTransparency = 1}, Content)
New("UIGridLayout", {CellSize = UDim2.new(0.25, -5, 1, 0), CellPadding = UDim2.fromOffset(6, 0), SortOrder = Enum.SortOrder.LayoutOrder}, TabBar)
local PageHolder = New("Frame", {Size = UDim2.new(1, -20, 1, -88), Position = UDim2.fromOffset(10, 80), BackgroundTransparency = 1}, Content)

local tabs, currentPage = {}, nil
local order = {}
local function nextOrder(p) order[p] = (order[p] or 0) + 1 return order[p] end

local function SelectTab(page)
    currentPage = page
    for _, t in ipairs(tabs) do
        t.page.Visible = (t.page == page)
        Tween(t.btn, 0.25, {BackgroundTransparency = t.page == page and 0.45 or 0.9})
    end
end

local function AddTab(name)
    local btn = New("TextButton", {
        Text = name, BackgroundColor3 = white, BackgroundTransparency = 0.9, BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = white, AutoButtonColor = false,
        LayoutOrder = #tabs + 1,
    }, TabBar)
    Corner(btn, 8)
    local page = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        Visible = false, ScrollingDirection = Enum.ScrollingDirection.Y,
    }, PageHolder)
    New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, page)
    New("UIPadding", {PaddingBottom = UDim.new(0, 6)}, page)
    local entry = {btn = btn, page = page}
    tabs[#tabs + 1] = entry
    btn.Activated:Connect(function() SelectTab(page) end)
    Themed(function()
        btn.BackgroundColor3 = (currentPage == page) and Theme.accent or white
        page.ScrollBarImageColor3 = Theme.accent
    end)
    return page
end

