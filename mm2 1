local isOpen = true
local function setOpen(v)
    isOpen = v
    if v then
        Main.Visible = true
        MainScale.Scale = 0.5 * BASE_SCALE
        Tween(MainScale, 0.4, {Scale = BASE_SCALE}, Enum.EasingStyle.Back)
    else
        Tween(MainScale, 0.22, {Scale = 0.01}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.23, function()
            if not isOpen then Main.Visible = false end
        end)
    end
end
MakeDraggable(Mini, Mini, function() setOpen(not isOpen) end)

