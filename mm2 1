    Round(sw)
    local fill = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.accent, BackgroundTransparency = default and 0 or 1, BorderSizePixel = 0}, sw)
    Round(fill)
    local knob = New("Frame", {
        Size = UDim2.fromOffset(16, 16), Position = default and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
        BackgroundColor3 = white, BorderSizePixel = 0,
    }, sw)
    Round(knob)
    Themed(function() fill.BackgroundColor3 = Theme.accent end)
    local state = default
    local btn = New("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ""}, r)
    btn.Activated:Connect(function()
        state = not state
        Tween(knob, 0.2, {Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)})
        Tween(fill, 0.2, {BackgroundTransparency = state and 0 or 1})
        cb(state)
    end)
end

local function Slider(page, text, min, max, default, cb)
    local r = Row(page, 46)
    New("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.fromOffset(12, 2), BackgroundTransparency = 1,
        Text = text, TextColor3 = C(235, 238, 245), Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, r)
    local val = New("TextLabel", {
        Size = UDim2.new(0.3, 0, 0, 22), Position = UDim2.new(0.7, -12, 0, 2), BackgroundTransparency = 1,
        Text = tostring(default), TextColor3 = white, Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, r)
    local track = New("Frame", {
        Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = GREY, BackgroundTransparency = 0.35, BorderSizePixel = 0,
    }, r)
    Round(track)
    local fill = New("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.accent, BorderSizePixel = 0}, track)
    Round(fill)
    local knob = New("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = white, BorderSizePixel = 0,
    }, track)
    Round(knob)
    Themed(function() fill.BackgroundColor3 = Theme.accent end)

    local function set(v)
        v = math.clamp(math.floor(v + 0.5), min, max)
        local a = (v - min) / (max - min)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        val.Text = tostring(v)
        cb(v)
    end
    local function fromInput(pos)
        local a = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        set(min + (max - min) * a)
    end
    local dragging = false
    local hit = New("TextButton", {
        Size = UDim2.new(1, -12, 0, 26), Position = UDim2.new(0, 6, 0, 20), BackgroundTransparency = 1, Text = "",
    }, r)
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(i.Position)
            local ch
            ch = i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false ch:Disconnect() end
            end)
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            fromInput(i.Position)
        end
    end)
    set(default)
end

