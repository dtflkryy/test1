local kp    = NumberSequenceKeypoint.new
local ck    = ColorSequenceKeypoint.new
local function C(r, g, b) return Color3.fromRGB(r, g, b) end

local conns = {}
local function bind(sig, fn)
    local c = sig:Connect(fn)
    conns[#conns + 1] = c
    return c
end

local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function Corner(o, r) return New("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function Round(o) return New("UICorner", {CornerRadius = UDim.new(0.5, 0)}, o) end
local function Tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

