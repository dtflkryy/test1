bind(UIS.JumpRequest, function()
	if state.jump then
		local h = hum()
		if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

bind(RS.Stepped, function()
	if state.noclip and char() then
		for _, part in ipairs(char():GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end
end)

bind(RS.Heartbeat, function()
	if current.rainbow then paint() end
	local h = hum()
	if state.speed and h then h.WalkSpeed = SPEED end
	if state.fly then
		local root = hrp()
		if root then
			if not bv or bv.Parent ~= root then
				stopFly()
				bv = new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, root)
			end
			local cam = workspace.CurrentCamera
			if h and h.MoveDirection.Magnitude > 0 then
				bv.Velocity = cam.CFrame.LookVector * FLY_SPEED
			else
				bv.Velocity = Vector3.zero
			end
		end
	end
end)

