env.MM2Hub_Cleanup = function()
	alive = false
	state.esp, state.gunesp, state.fly = false, false, false
	pcall(clearESP)
	pcall(clearGunESP)
	pcall(stopFly)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	gui:Destroy()
end
