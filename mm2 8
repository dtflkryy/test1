task.spawn(function()
	while alive do
		local ch = current.particle
		if ch and open then
			local l = new("TextLabel", {
				Text = ch, BackgroundTransparency = 1, TextSize = math.random(14, 24), ZIndex = 2,
				Size = UDim2.fromOffset(24, 24), TextTransparency = 0.15,
				Position = UDim2.new(math.random(), -12, 1, 0),
			}, main)
			local x = l.Position.X
			local tw = TS:Create(l, TweenInfo.new(math.random(30, 50) / 10, Enum.EasingStyle.Sine), {
				Position = UDim2.new(x.Scale, x.Offset + math.random(-25, 25), 0, -24),
