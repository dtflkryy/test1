------------------------------------------------ Lock + drag
local locked = false
local moved = {}

local function makeDraggable(obj, handle)
	handle = handle or obj
	local dragging, startPos, startObj = false, nil, nil
	bind(handle.InputBegan, function(i)
		if locked then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved[obj] = false
			startPos = i.Position
			startObj = obj.Position
		end
	end)
	bind(handle.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	bind(UIS.InputChanged, function(i)
		if not dragging or locked then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			local d = i.Position - startPos
			if d.Magnitude > 6 then moved[obj] = true end
			obj.Position = UDim2.new(startObj.X.Scale, startObj.X.Offset + d.X, startObj.Y.Scale, startObj.Y.Offset + d.Y)
		end
	end)
end

