local function addToggle(name, cb)
	local on = false
	local b = makeBtn(name)
	table.insert(rows, {btn = b, on = function() return on end})
	bind(b.Activated, function()
		on = not on
		b.Text = name .. (on and "  ✓" or "")
		paint()
		cb(on)
	end)
end

local function addAction(name, fn)
	local b = makeBtn(name)
	b.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
	bind(b.Activated, function() fn(b) end)
	return b
end

------------------------------------------------ Features
local state = {esp = false, gunesp = false, speed = false, jump = false, noclip = false, fly = false}
local SPEED, FLY_SPEED = 45, 60

local function char() return lp.Character end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end

-- roles
local function roleOf(p)
	local c = p.Character
	local bp = p:FindFirstChild("Backpack")
	local function has(n) return (c and c:FindFirstChild(n)) or (bp and bp:FindFirstChild(n)) end
	if has("Knife") then return "M" end
	if has("Gun") then return "S" end
	return "I"
end
local roleColor = {M = Color3.fromRGB(255, 50, 50), S = Color3.fromRGB(60, 140, 255), I = Color3.fromRGB(80, 255, 120)}

local function clearESP()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChild("MM2ESP")
		if h then h:Destroy() end
	end
end

local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local h = p.Character:FindFirstChild("MM2ESP")
			if not h then
				h = new("Highlight", {Name = "MM2ESP", FillTransparency = 0.5, OutlineTransparency = 0,
					DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, p.Character)
			end
			local col = roleColor[roleOf(p)]
			h.FillColor = col
			h.OutlineColor = col
		end
	end
end

local function updateInfo()
	local m, s = "?", "?"
	for _, p in ipairs(Players:GetPlayers()) do
		local r = roleOf(p)
		if r == "M" then m = p.Name elseif r == "S" then s = p.Name end
	end
	info.Text = "🔪 Murderer: " .. m .. "\n🔫 Sheriff: " .. s
end

-- dropped gun
local gun
local function findGun()
	if gun and gun.Parent then return gun end
	gun = nil
	local g = workspace:FindFirstChild("GunDrop", true)
	if g then
		gun = g:IsA("BasePart") and g or g:FindFirstChildWhichIsA("BasePart", true)
	end
	return gun
end

local gunLine = new("Frame", {
	Name = "GunLine", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 230, 60),
	BorderSizePixel = 0, Visible = false, ZIndex = 20, Size = UDim2.fromOffset(0, 2),
}, gui)

local function clearGunESP()
	gunLine.Visible = false
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == "MM2GunESP" then d:Destroy() end
	end
end

local function updateGunESP()
	local g = findGun()
	if g and not g:FindFirstChild("MM2GunESP") then
		new("Highlight", {Name = "MM2GunESP", FillColor = Color3.fromRGB(255, 230, 60),
			OutlineColor = Color3.fromRGB(255, 255, 255), FillTransparency = 0.3,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = g}, g)
	end
end

bind(RS.RenderStepped, function()
	if not state.gunesp or not gun or not gun.Parent then
		gunLine.Visible = false
		return
	end
	local cam = workspace.CurrentCamera
	local vs = cam.ViewportSize
	local v = cam:WorldToViewportPoint(gun.Position)
	local ex, ey = v.X, v.Y
	if v.Z < 0 then -- gun is behind the camera: mirror through screen center
		ex, ey = vs.X - ex, vs.Y - ey
	end
	local sx, sy = vs.X / 2, 0
	local dx, dy = ex - sx, ey - sy
	local len = math.sqrt(dx * dx + dy * dy)
	gunLine.Size = UDim2.fromOffset(len, 2)
	gunLine.Position = UDim2.fromOffset(sx + dx / 2, sy + dy / 2)
	gunLine.Rotation = math.deg(math.atan2(dy, dx))
	gunLine.Visible = true
end)

-- teleport to gun, back after 2s
local tping = false
local function tpGun(btn)
	if tping then return end
	local g = findGun()
	local root = hrp()
	if not g or not root then
		local old = btn.Text
		btn.Text = "Chưa có súng"
		task.delay(1.2, function() if btn.Parent then btn.Text = old end end)
		return
	end
	tping = true
	local back = root.CFrame
	root.CFrame = g.CFrame + Vector3.new(0, 2, 0)
	task.wait(2)
	root = hrp()
	if root then
		root.CFrame = back
		root.AssemblyLinearVelocity = Vector3.zero
	end
	tping = false
end

