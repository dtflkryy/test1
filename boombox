-- Hàm tạo các ô chức năng nhập số / text
local function createInputRow(labelText, placeholder, defaultVal, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 18)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(190, 190, 205)
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 28)
    box.Position = UDim2.new(0, 0, 0, 20)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = placeholder
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.PlaceholderColor3 = Color3.fromRGB(100, 100, 120)
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = f

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = box

    box.FocusLost:Connect(function()
        if callback then callback(box.Text) end
    end)

    return f
end

