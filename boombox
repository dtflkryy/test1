-- Hàm tạo Boombox Tool
local function createBoomboxTool()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    if not backpack then return end

    -- Kiểm tra nếu đã có tool trong backpack hoặc character
    if backpack:FindFirstChild("ProBoombox") or (character and character:FindFirstChild("ProBoombox")) then
        return
    end

    tool = Instance.new("Tool")
    tool.Name = "ProBoombox"
    tool.RequiresHandle = true
    tool.ToolTip = "Ultimate Boombox - Delta X"

    handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1.2, 0.8, 2)
    handle.CanCollide = false

    -- Thử tải item ID 212641536, nếu lỗi sẽ dùng block mặc định kèm mesh
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://212641536")
    end)

    if success and objects and #objects > 0 then
        local loaded = objects[1]
        if loaded:IsA("Tool") and loaded:FindFirstChild("Handle") then
            handle:Destroy()
            handle = loaded.Handle:Clone()
            handle.Name = "Handle"
            loaded:Destroy()
        end
    end

    -- Đảm bảo có SpecialMesh nếu chưa có
    if not handle:FindFirstChildOfClass("SpecialMesh") and not handle:FindFirstChildOfClass("MeshPart") then
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://212641536"
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = handle
    end

    handle.Parent = tool

    -- Cài đặt Sound
    sound = Instance.new("Sound")
    sound.Name = "BoomboxSound"
    sound.SoundId = "rbxassetid://1848354536" -- Nhạc mặc định
    sound.Volume = 2
    sound.Looped = true
    sound.RollOffMaxDistance = 150
    sound.RollOffMinDistance = 15
    sound.Parent = handle

    -- Hiệu ứng Bass (Equalizer)
    eq = Instance.new("EqualizerSoundEffect")
    eq.Name = "BassBoost"
    eq.LowGain = 0 -- Chỉnh bass
    eq.MidGain = 0
    eq.HighGain = 0
    eq.Parent = sound

    -- Hiệu ứng Độ "Beat" / Distortion
    distortion = Instance.new("DistortionSoundEffect")
    distortion.Name = "BeatDistortion"
    distortion.Level = 0 -- Chỉnh độ đậm nhạt beat
    distortion.Parent = sound

    tool.Parent = backpack
    setupToolEvents(tool, character)
end

-- Hàm gắn boombox ra sau lưng khi không cầm
local function weldToBack(char)
    if not char or not handle then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    if currentWeld then currentWeld:Destroy() end

    handle.Anchored = false
    currentWeld = Instance.new("Weld")
    currentWeld.Name = "BackWeld"
    currentWeld.Part0 = torso
    currentWeld.Part1 = handle
    -- Vị trí hiển thị trên lưng
    currentWeld.C0 = CFrame.new(0, 0.2, 0.6) * CFrame.Angles(0, math.rad(180), 0)
    currentWeld.Parent = handle
end

local function removeWeld()
    if currentWeld then
        currentWeld:Destroy()
        currentWeld = nil
    end
end

function setupToolEvents(t, char)
    t.Equipped:Connect(function()
        removeWeld()
    end)

    t.Unequipped:Connect(function()
        local character = player.Character
        if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
            weldToBack(character)
        end
    end)

    -- Mặc định khi mới nhận sẽ treo ở lưng nếu không cầm
    if char then
        weldToBack(char)
    end
end

