---------------------------------------------------------------- LOOPS
local fps = 60
RS.RenderStepped:Connect(function(dt)
	fps = fps + (1 / dt - fps) * 0.1
	-- sheen chuyển động nhẹ (liquid)
	sheen.Offset = Vector2.new(math.sin(tick() * 0.6) * 0.25, math.cos(tick() * 0.5) * 0.25)
	strokeGrad.Rotation = (tick() * 40) % 360
	if current.special == "rainbow" then
		local h = (tick() * 0.15) % 1
		applyColors(Color3.fromHSV(h, 0.7, 1), Color3.fromHSV((h + 0.3) % 1, 0.7, 1))
	end
end)

task.spawn(function()
	while gui.Parent do
		local ping = math.floor((lp:GetNetworkPing() or 0) * 1000)
		infoLbl.Text = ("FPS: %d  |  Ping: %d ms"):format(fps, ping)
		task.wait(0.5)
	end
end)

-- hiệu ứng trôi nổi (tim / cỏ 4 lá)
task.spawn(function()
	local rng = Random.new()
	while gui.Parent do
		local sp = current.special
		if (sp == "heart" or sp == "clover") and isOpen then
			local size = rng:NextInteger(14, 26)
			local x = rng:NextNumber(0.03, 0.95)
			local p = new("TextLabel", {
				Text = sp == "heart" and "♥" or "🍀", TextSize = size, Font = Enum.Font.GothamBold,
				TextColor3 = sp == "heart" and Color3.fromRGB(255, rng:NextInteger(70, 150), rng:NextInteger(120, 190)) or Color3.fromRGB(110, 220, 130),
				BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Position = UDim2.new(x, 0, 1.05, 0),
				TextTransparency = 0.15, Rotation = rng:NextInteger(-20, 20),
			}, fx)
			local dur = rng:NextNumber(4, 7)
			TS:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Sine), {
				Position = UDim2.new(math.clamp(x + rng:NextNumber(-0.12, 0.12), 0, 0.95), 0, -0.1, 0),
				TextTransparency = 1, Rotation = rng:NextInteger(-40, 40),
			}):Play()
			task.delay(dur, function() p:Destroy() end)
		end
		task.wait(0.3)
	end
end)

