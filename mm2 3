local pages, tabBtns = {}, {}
local function addPage(name)
	local p = new("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 78), Size = UDim2.new(1, -20, 1, -88), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false, ZIndex = 5,
	}, main)
	new("UIListLayout", { Padding = UDim.new(0, 8) }, p)
	local b = new("TextButton", {
		Text = name, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(84, 28), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, AutoButtonColor = false, ZIndex = 6,
	}, tabBar)
	new("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
	pages[name], tabBtns[name] = p, b
	b.MouseButton1Click:Connect(function()
		for n, pg in pairs(pages) do
			pg.Visible = (n == name)
			tween(tabBtns[n], 0.2, { BackgroundTransparency = n == name and 0.5 or 0.8 })
		end
	end)
	return p
end

local function row(parent, height)
	local f = new("Frame", { Size = UDim2.new(1, -4, 0, height or 34), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, ZIndex = 6 }, parent)
	new("UICorner", { CornerRadius = UDim.new(0, 10) }, f)
	return f
end

local function label(parent, text)
	return new("TextLabel", {
		Text = text, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(10, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7,
	}, parent)
end

local function button(parent, text, cb)
	local r = row(parent)
	local b = new("TextButton", { Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 7 }, r)
	b.MouseButton1Click:Connect(function()
		tween(r, 0.1, { BackgroundTransparency = 0.6 }).Completed:Connect(function() tween(r, 0.2, { BackgroundTransparency = 0.82 }) end)
		cb()
	end)
	return b
end

local function toggle(parent, text, default, cb)
	local r = row(parent)
	label(r, text)
	local state = default
	local sw = new("TextButton", { Text = "", Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = state and 0.2 or 0.7, AutoButtonColor = false, ZIndex = 7 }, r)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, sw)
	local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 8 }, sw)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	sw.MouseButton1Click:Connect(function()
		state = not state
		tween(knob, 0.2, { Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2) })
		tween(sw, 0.2, { BackgroundTransparency = state and 0.2 or 0.7 })
		cb(state)
	end)
end

local function slider(parent, text, min, max, default, cb)
	local r = row(parent, 48)
	local lbl = new("TextLabel", { Text = text .. ": " .. default, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7 }, r)
	local bar = new("Frame", { Position = UDim2.new(0, 10, 1, -16), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7, ZIndex = 7 }, r)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
	local fill = new("Frame", { Size = UDim2.fromScale((default - min) / (max - min), 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 8 }, bar)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
	table.insert(accents, { fill, "BackgroundColor3" })
	local dragging = false
	local function set(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * a + 0.5)
		fill.Size = UDim2.fromScale(a, 1)
		lbl.Text = text .. ": " .. v
		cb(v)
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; moved = true; set(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then set(i.Position.X) end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
end

