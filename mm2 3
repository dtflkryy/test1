---------------------------------------------------------------- OPEN / CLOSE
local isOpen = true
local function setOpen(v)
	isOpen = v
	if v then
		main.Visible = true
		mainScale.Scale = 0.85
		main.GroupTransparency = 1
		tween(mainScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(main, 0.3, { GroupTransparency = 0 })
		if blurEnabled then tween(blur, 0.4, { Size = 10 }) end
	else
		tween(mainScale, 0.25, { Scale = 0.85 })
		local t = tween(main, 0.25, { GroupTransparency = 1 })
		tween(blur, 0.3, { Size = 0 })
		t.Completed:Connect(function() if not isOpen then main.Visible = false end end)
	end
end
bubble.MouseButton1Click:Connect(function() if not moved then setOpen(not isOpen) end end)
closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)

