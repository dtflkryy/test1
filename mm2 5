-- Anti-AFK
local afkConn
local function antiAfk(on)
	if on and not afkConn then
		afkConn = lp.Idled:Connect(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
	elseif not on and afkConn then
		afkConn:Disconnect(); afkConn = nil
	end
end

-- FPS Boost
local boosted, origQuality = {}, nil
local function fpsBoost(on)
	if on then
		pcall(function()
			origQuality = origQuality or settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Beam") then
				if d.Enabled then d.Enabled = false; boosted[#boosted + 1] = d end
			end
		end
	else
		for _, d in ipairs(boosted) do pcall(function() d.Enabled = true end) end
		boosted = {}
		if origQuality then pcall(function() settings().Rendering.QualityLevel = origQuality end); origQuality = nil end
	end
end

-- Fullbright
local fbSaved
local function fullbright(on)
	if on then
		fbSaved = fbSaved or {
			Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
		}
		Lighting.Brightness = 2; Lighting.ClockTime = 14; Lighting.FogEnd = 1e6; Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(178, 178, 178); Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
	elseif fbSaved then
		for k, v in pairs(fbSaved) do Lighting[k] = v end
		fbSaved = nil
	end
end

-- Mở khoá zoom camera
local origZoom
local function zoomUnlock(on)
	if on then
		origZoom = origZoom or { max = lp.CameraMaxZoomDistance, min = lp.CameraMinZoomDistance }
		lp.CameraMaxZoomDistance = 10000
		lp.CameraMinZoomDistance = 0
	elseif origZoom then
		lp.CameraMaxZoomDistance = origZoom.max
		lp.CameraMinZoomDistance = origZoom.min
		origZoom = nil
	end
end

local function serverHop()
	toast("Đang tìm server khác...")
	task.spawn(function()
		local ok, res = pcall(function()
			return HttpService:JSONDecode(game:HttpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)))
		end)
		if ok and res and res.data then
			local list = {}
			for _, s in ipairs(res.data) do
				if s.id ~= game.JobId and s.playing < s.maxPlayers then list[#list + 1] = s.id end
			end
			if #list > 0 then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], lp)
				return
			end
		end
		toast("Không tìm được server khác")
	end)
end

local function doCopy(text, okMsg)
	if copyFn then
		pcall(copyFn, text)
		toast(okMsg)
	else
		toast("Executor không hỗ trợ copy")
	end
end

