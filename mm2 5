local isOpen = true
local function setOpen(v)
	isOpen = v
	if v then
		main.Visible = true
		mainScale.Scale = baseScale * 0.85
		main.GroupTransparency = 1
		tween(mainScale, 0.35, { Scale = baseScale }, Enum.EasingStyle.Back)
		tween(main, 0.3, { GroupTransparency = 0 })
		if blurEnabled then tween(blur, 0.4, { Size = 8 }) end
	else
		tween(mainScale, 0.25, { Scale = baseScale * 0.85 })
		local t = tween(main, 0.25, { GroupTransparency = 1 })
		tween(blur, 0.3, { Size = 0 })
		t.Completed:Connect(function() if not isOpen then main.Visible = false end end)
	end
end
bind(bubble.MouseButton1Click, function()
	if not bubbleMoved() then setOpen(not isOpen) end
end)
bind(closeBtn.MouseButton1Click, function() setOpen(false) end)
bind(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then setOpen(not isOpen) end
end)

